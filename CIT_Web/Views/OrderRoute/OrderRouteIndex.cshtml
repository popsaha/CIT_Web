@model CIT_Web.Models.ViewModel.OrderRouteVM
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}



<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<div class="card" style="margin: 10px;">
    <div class="card-header text-white btn-color-main">
        <h5 class="card-title btn-color-main">Police Form</h5>
    </div>
    <div class="card-body">
        <!-- Display success message if available -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        <!-- Display form validation errors -->
        <div asp-validation-summary="All" class="text-danger"></div>

        <form method="post" asp-action="OrderRouteIndex" novalidate>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Route Name</label>
                        <input class="form-control" asp-for="orderRouteCreateDTOs.RouteName" />
                        <span class="text-danger" asp-validation-for="orderRouteCreateDTOs.RouteName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Route Description</label>
                        <input class="form-control" asp-for="orderRouteCreateDTOs.RouteDescription" />
                        <span class="text-danger" asp-validation-for="orderRouteCreateDTOs.RouteDescription"></span>
                    </div>
                </div>
            </div>

           
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-color me-2">
                    <i class="bi bi-save"></i> Submit
                </button>
                <button type="reset" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Reset
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Apply jQuery validation
        $("form").validate({
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid");
            },
        });
    });
</script>

<style>
    .is-invalid {
        border-color: red !important;
    }
</style>




<div class="table-tab-content" id="myTabContent" style="overflow-x: auto;">
    <div class="col-auto py-1 ms-2 mt-2">
        <div class="table-container" style="margin-right: 16px;">
            <table id="dataTable" class="table datatable table-bordered table-hover">
                <thead>
                    <tr>
                        <th></th>
                        <th>RouteName</th>
                        <th>RouteDescription</th>                    
                        <th>Action</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var route in Model.OrderRoutesList)
                    {
                        <tr>
                            <td><input type="checkbox"></td>
                            <td>@route.RouteName</td>
                            <td>@route.RouteDescription</td>                            
                            <td>
                                <a asp-action="Edit" asp-route-id="@route.OrderRouteId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-action="DeleteRoute" style="display:inline;">
                                    <input type="hidden" name="OrderRouteId" value="@route.OrderRouteId" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this Route?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>