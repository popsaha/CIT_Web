@model CIT_Web.Models.Dto.Customer.CustomerUpdateDTO


<div class="card " style="margin: 10px;">
    <div class="card-header text-white btn-color">
        <h5 class="card-title btn-color">Customer Edit Form</h5>
    </div>
    <div class="card-body">
     
        <form method="post" asp-action="EditCustomer" novalidate>
            <input type="hidden" asp-for="CustomerId" />
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Customer Name</label>
                        <input class="form-control" asp-for="CustomerName" />
                        <span class="text-danger" asp-validation-for="CustomerName"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">CustomerCode</label>
                        <input class="form-control" asp-for="CustomerCode" />
                        <span class="text-danger" asp-validation-for="CustomerCode"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" asp-for="Email" />
                        <span class="text-danger" asp-validation-for="Email"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" asp-for="Address" />
                        <span class="text-danger" asp-validation-for="Address"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Contact Number</label>
                        <input class="form-control" asp-for="ContactNumber" />
                        <span class="text-danger " asp-validation-for="ContactNumber"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">ReferenceNo1</label>
                        <input class="form-control" asp-for="ReferenceNo1" />
                        <span class="text-danger" asp-validation-for="ReferenceNo1"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">ReferenceNo2</label>
                        <input class="form-control" asp-for="ReferenceNo2" />
                        <span class="text-danger " asp-validation-for="ReferenceNo2"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label" for="country">Country</label>
                        <select class="form-select" id="country" asp-for="Country">
                            <option value="" disabled selected>Select Country</option>
                            <option value="Kenya">Kenya</option>
                        </select>
                        <span class="text-danger" asp-validation-for="Country"></span>
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">City</label>
                        <input class="form-control" asp-for="City" />
                        <span class="text-danger" asp-validation-for="City"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">PostalCode</label>
                        <input class="form-control" asp-for="PostalCode" />
                        <span class="text-danger" asp-validation-for="PostalCode"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">TaxNumber</label>
                        <input class="form-control" asp-for="TaxNumber" />
                        <span class="text-danger" asp-validation-for="TaxNumber"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-color me-2">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="IndexCustomer" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>