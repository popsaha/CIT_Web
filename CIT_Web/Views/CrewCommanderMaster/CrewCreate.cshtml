@model CIT_Web.Models.ViewModel.RoleCrewVM


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<div class="card" style="margin: 10px;">
    <div class="card-header text-white btn-color-main">
        <h5 class="card-title btn-color-main">Crew Commander Form</h5>
    </div>
    <div class="card-body">
        <!-- Display success message if available -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        <form method="post" asp-action="CrewCreate">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">User Name</label>
                        <input class="form-control" asp-for="CrewUser.UserName" />
                        <span class="text-danger" asp-validation-for="CrewUser.UserName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" asp-for="CrewUser.Password" type="password" />
                        <span class="text-danger" asp-validation-for="CrewUser.Password"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select class="form-select" asp-for="CrewUser.RoleName">
                            <option selected disabled>Select a role</option>
                            @foreach (var role in Model.Roles)
                            {
                                if (role.RoleName == "Crew")
                                {
                                    <option value="@role.RoleName" selected>@role.RoleName</option>
                                }
                                else
                                {
                                    <option value="@role.RoleName">@role.RoleName</option>
                                }
                            }
                        </select>

                        <span class="text-danger" asp-validation-for="CrewUser.RoleName"></span>

                       
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Region</label>
                        <select class="form-select" asp-for="CrewUser.RegionName">
                            <option selected disabled>Select a region</option>
                            @foreach (var region in Model.Regions)
                            {
                                <option value="@region.RegionName">@region.RegionName</option> <!-- Change RoleID to RoleName -->
                            }
                        </select>

                        <span class="text-danger" asp-validation-for="CrewUser.RegionName"></span>


                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-color me-2">
                    <i class="bi bi-save"></i> Submit
                </button>
                <button type="reset" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Reset
                </button>
            </div>
        </form>
    </div>
</div>



<div class="table-tab-content" id="myTabContent" style="overflow-x: auto;">
    <div class="col-auto py-1 ms-2 mt-2">
        <div class="table-container" style="margin-right: 16px;">
            <table id="dataTable" class="table datatable table-bordered table-hover">
                <thead>
                    <tr>
                        <th></th>
                        <th>UserName</th>
                        <th>Password</th>
                        <th> Date</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var users in Model.userMasters)
                    {
                        <tr>
                            <td><input type="checkbox"></td>
                            <td>@users.UserName</td>
                            <td>@users.Password</td>
                            <td>@users.CreatedOn</td>
                            <td>@users.IsActive</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@users.UserId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-action="DeleteCrew" style="display:inline;">
                                    <input type="hidden" name="userId" value="@users.UserId" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>


                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        // Apply jQuery validation
        $("form").validate({
            errorClass: "text-danger",
            highlight: function (element) {
                $(element).addClass("is-invalid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid");
            },
        });
    });
</script>

<style>
    .is-invalid {
        border-color: red !important;
    }
</style>