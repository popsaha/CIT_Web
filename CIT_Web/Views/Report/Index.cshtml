@model Task<CIT_Web.Models.Reports.ViewModel>;



<link rel="stylesheet" href="~/css/Report.css" />
@* <script src="~/js/jquery.min.js"></script> *@





<style>
    .open-btn {
        /* background-color: #007bff; */
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
    }

        .open-btn:hover {
            background-color: #0056b3;
            color: white
        }

    /* Modal container styling */
    .modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        width: 400px;
        display: none; /* Initially hidden */
        z-index: 1000;
        height: 200px;
    }

    /* Overlay styling */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        z-index: 999;
    }

    /* Show the modal and overlay when the target is active */
    #popup:target {
        display: block;
    }

        #popup:target + .modal-overlay {
            display: block;
        }

    /* Close button styling */
    .close-btn {
        background: #f44336;
        color: white;
        border: none;
        padding: 5px 10px;
        cursor: pointer;
        border-radius: 5px;
    }

        .close-btn:hover {
            background-color: #d32f2f;
            color: white;
        }

    .BillDetails {
        text-align: center;
        font-size: 16px;
        background-color: blue;
        color: white;
        padding: 3px;
        margin-bottom:20px ;
    }

    .TextDetails {
        font-size: 14px;
        padding-top: 3px;
    }
</style>




<div class="body">
    <section class="container_Ben">
        @* <header>Add Beneficery</header>*@
        <form action="/Report/Index" method="post" class="form">

            <div id="AddBeneficery">

                <div class="column">
                    <div class="select-box dropdown dropdown-list">
                        <label id="CustomerSelectedText" name="Customername" style="display:none"></label>
                        <select id="IdCustomerDrop">
                            <option hidden>--Select Customer--</option>
                            @foreach (var item in Model.Result.DroDownData)
                            {
                                if (item.Group.Name == "Customer")
                                {
                                    <option class="dropdown-option" value="@item.Value"> @item.Text </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="select-box">

                        <div class="dropdown" id="Service" data-control="checkbox-dropdown">
                            <label class="dropdown-label">Select</label>
                            <label id="ServiceSelectedText" name="Servicename" style="display:none"></label>

                            <div class="dropdown-list">
                                <a href="#" data-toggle="check-all" class="dropdown-option">
                                    Check All
                                </a>

                                @foreach (var item in Model.Result.DroDownData)
                                {
                                    if (item.Group.Name == "Service")
                                    {
                                        <label class="dropdown-option">
                                            <input type="checkbox" name="Service-dropdown-group" value="@item.Value" />
                                            @item.Text
                                        </label>
                                    }
                                }

                            </div>
                        </div>

                    </div>
                    <div class="select-box">



                        <div class="dropdown" id="Branch" data-control="checkbox-dropdown">
                            <label class="dropdown-label">Select</label>
                            <label id="BranchSelectedText" name="Branchname" style="display:none"></label>

                            <div class="dropdown-list">
                                <a href="#" data-toggle="check-all" class="dropdown-option">
                                    Check All
                                </a>

                                @foreach (var item in Model.Result.DroDownData)
                                {
                                    if (item.Group.Name == "Branch")
                                    {
                                        <label class="dropdown-option">
                                            <input type="checkbox" name="Branch-dropdown-group" value="@item.Value" />
                                            @item.Text
                                        </label>
                                    }
                                }

                            </div>
                        </div>

                    </div>


                @* </div> *@

                @* <div class="column"> *@
                    <div class="input-box">
                        @* <label>From Date</label> *@
                        <input type="date" id="fromdate" />
                    </div>
                    <div class="input-box">
                        @* <label>To Date</label> *@
                        <input type="date" id="todate" />
                    </div>
                    <div class="">
                        @* <label></label> *@
                        <button class="btn btn-color mt-2" onclick="return FeatchData()" style="height:38px">Search </button>

                    </div>
                </div>


                <div>


                    <div id="NoralView" style="margin-bottom:20px">

                        <div id="tbody" style="overflow-x : auto"></div>





                    </div>
                    <div style="text-align:center">
                        <a href="#popup" class="open-btn btn-color" onclick="return BtnGenratebill()">Genrate Bill</a>
                    </div>
                 

                    <!-- Modal popup -->
                    <div id="popup" class="modal" >
                        <div class="BillDetails  btn-color-main">Bill Details</div>
                        <div class="textDetails">Total : <span id="TotalAmount"></span></div>
                        <div class="textDetails">Tax (5%) : <span id="Tax"></span></div>
                        <div class="textDetails">Vat (10%) : <span id="Vat"></span></div>
                        <div class="textDetails">Final Amount : <span id="FinalAmount"></span></div>
                        <div style="margin-top: 10px;"><a href="#" class="close-btn">Close</a></div>
                    </div>

                    <!-- Overlay -->
                    <div class="modal-overlay"></div>
                </div>

            </div>

            @* <button>Submit</button>*@
        </form>
    </section>
</div>





