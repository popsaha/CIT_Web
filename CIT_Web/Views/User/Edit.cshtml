@model CIT_Web.Models.ViewModel.UserRoleVM





<div class="card" style="margin: 10px;">
    <div class="card-header text-white btn-color">
        <h5 class="card-title btn-color">Edit User</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-action="EditUser" novalidate>
            <input type="hidden" asp-for="createDTO.UserId" />
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">User Name</label>
                        <input class="form-control" asp-for="createDTO.UserName" />
                        <span class="text-danger" asp-validation-for="createDTO.UserName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" asp-for="createDTO.Password" type="password" />
                        <span class="text-danger" asp-validation-for="createDTO.Password"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select class="form-select" asp-for="createDTO.RoleName">
                            <option selected disabled>Select a role</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.RoleName">@role.RoleName</option> <!-- Change RoleID to RoleName -->
                            }
                        </select>

                        <span class="text-danger" asp-validation-for="createDTO.RoleName"></span>


                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Region</label>
                        <select class="form-select" asp-for="createDTO.RegionName">
                            <option selected disabled>Select a region</option>
                            @foreach (var region in Model.Regions)
                            {
                                <option value="@region.RegionName">@region.RegionName</option> <!-- Change RoleID to RoleName -->
                            }
                        </select>

                        <span class="text-danger" asp-validation-for="createDTO.RegionName"></span>


                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-color me-2">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <a asp-action="UserIndex" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>